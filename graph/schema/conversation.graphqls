enum ConversationType {
  DIRECT
  GROUP
}

type Conversation {
  id: ID!
  type: ConversationType!
  name: String
  avatar: String
  restaurantID: String!
  lastMessageAt: Time
  participants: [Participant!]!
  isDeleted: Boolean!
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type Participant {
  id: ID!
  conversationID: String!
  authorID: String!
  isDeleted: Boolean!
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type Message {
  id: ID!
  conversationID: String!
  senderID: String!
  content: String!
  imageUrl: String
  isDeleted: Boolean!
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type ConversationPagination {
  data: [Conversation!]!
  total: Int!
  currentPage: Int!
  totalPages: Int!
}

type MessagePagination {
  data: [Message!]!
  total: Int!
  currentPage: Int!
  totalPages: Int!
}

input CreateGroupConversationInput {
  resID: String!
  name: String!
  avatar: String
  participantIDs: [ID!]!
}

input SendMessageInput {
  conversationID: ID!
  resID: String!
  content: String
  imageUrl: String
}

extend type Query {
  conversation(conversationID: ID!, resID: String!): Conversation!
  myConversations(resID: String!, limit: Int = 10, page: Int = 1): ConversationPagination!
  messages(conversationID: ID!, resID: String!, limit: Int = 10, page: Int = 1): MessagePagination!
}

extend type Mutation {
  createDirectConversation(resID: String!, targetUserID: ID!): Conversation!
  createGroupConversation(input: CreateGroupConversationInput!): Conversation!
  hideConversation(conversationID: ID!, resID: String!): Boolean!
  sendMessage(input: SendMessageInput!): Message!
}
